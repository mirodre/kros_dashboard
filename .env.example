# === Nastavenia používateľov (filtre) ===
# Bez tejto premennej appka beží ďalej, len si filtre pamätá iba v prehliadači — teda ako
# pred touto fázou. Migrácie sa aplikujú samy pri štarte servera.
# Ak to hostiteľ Postgresu vyžaduje, doplň `?sslmode=require`.
DATABASE_URL=

# === Voliteľné KROS API ===
KROS_API_BASE_URL=https://api-economy.kros.sk
NEXT_PUBLIC_KROS_CONSENT_BASE_URL=https://firma.kros.sk/integration-consent

# Zdieľané prihlásenie (authentication_service)
AUTH_SERVICE_URL=https://login.krosdoplnky.sk
AUTH_SERVICE_CLIENT_ID=
AUTH_SERVICE_CLIENT_SECRET=
# Voliteľné, defaulty sedia s TTL v službe
# AUTH_SERVICE_CLAIMS_TTL=900
# AUTH_SERVICE_GRACE_PERIOD=86400
# AUTH_SERVICE_TIMEOUT_MS=5000
# Kľúč appky pre odhlásenie (?app=), musí byť v allowliste AUTH_RETURN_APPS v službe. Default: prehlady
# AUTH_SERVICE_APP_KEY=prehlady

# Auth.js ním šifruje session cookie. Bez neho sa appka nerozbehne.
# Vygeneruj: openssl rand -base64 32
AUTH_SECRET=

# AUTH_URL prepisuje origin KAŽDÉHO requestu (`reqWithEnvURL` v next-auth), takže tu je
# zámerne lokálna hodnota: kto by si súbor skopíroval s produkčným originom a spustil
# `npm run dev`, skončil by presmerovaný do produkcie.
#
# Táto hodnota musí presne sedieť s redirect URI klienta v službe (Passport ho validuje
# presnou zhodou), takže pre localhost musí byť v službe zaregistrovaný aj
# http://localhost:3000/api/auth/callback/krosdoplnky.
#
# V PRODUKCII nastav `AUTH_URL=https://prehlady.krosdoplnky.sk` (pozri docs/SSO-prechod.md).
AUTH_URL=http://localhost:3000
